# Porta HTTP do servidor
PORT=3000

# Diretório de armazenamento do banco SQLite (benhermes.db)
DATA_DIR=./data

# Conta inicial de Administrador (criada automaticamente no 1º boot se não houver admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador

# Chave secreta para assinatura dos tokens de sessão
JWT_SECRET=altere-esta-chave-secreta-em-producao

# Confiança em cabeçalhos de proxy reverso (X-Forwarded-For / X-Real-IP)
TRUST_PROXY=true

# Lista de IPs e blocos CIDR liberados (separados por vírgula)
ALLOWED_IPS=2804:431:80f7:7700::/48,2804:1b3:a5e7:c3c7::/48,201.93.163.133,2804:1b3:a5e7:2c83::/48,201.93.159.169,2804:1b3:a5e7:8e38::/48,127.0.0.1,::1

